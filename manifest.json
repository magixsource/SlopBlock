{
  "name": "SlopBlock",
  "version": "1.0",
  "manifest_version": 3,
  "description": "在B站按UP主屏蔽视频",
  "icons": {
    "16": "images/icon_16.png",
    "32": "images/icon_32.png",
    "48": "images/icon_48.png",
    "128": "images/icon_128.png"
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background_script.js"
  },
  "action": {
    "default_icon": {
      "19": "images/icon_32.png",
      "38": "images/icon_32.png"
    },
    "default_title": "SlopBlock",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "css": [],
      "js": [
        "js/slopblock.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [{
    "resources": [
      "data/*.json"
    ],
    "matches": [
      "*://*/*"
    ]
  }],
  "host_permissions": [
    "http://*/*", "https://*/*"
  ]
}
